worker_processes auto;
worker_cpu_affinity auto;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    upstream backend-main {
        server $MAIN_HOST:$MAIN_PORT;
    }
	upstream backend-reader-1 {
        server $READER1_HOST:$READER1_PORT;
    }
	upstream backend-reader-2 {
        server $READER2_HOST:$READER2_PORT;
    }
	
	# по заданию балансировка на чтения 2:1:1
	upstream backend-readers {
        server $MAIN_HOST:$MAIN_PORT weight=2;
        server $READER1_HOST:$READER1_PORT weight=1;
        server $READER2_HOST:$READER2_PORT weight=1;
    }

    server {
        listen $HOST;
        server_name localhost;
        client_max_body_size 10M;

        # ==================== SWAGGER UI ROUTES ====================
        location ~ ^/api/v1/swagger/(.*)$ {
            proxy_pass http://backend-readers/swagger/$1$is_args$args;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/swagger/(.*)$ {
            proxy_pass http://backend-readers/swagger/$1$is_args$args;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location = /swagger/v1/swagger.json {
            proxy_pass http://backend-readers/swagger/v1/swagger.json;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location = /index.html {
            proxy_pass http://backend-readers/index.html;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==================== PUBLIC AUTH ENDPOINTS ====================
        location = /api/v1/auth/register {
            limit_except POST { deny all; }
            proxy_pass http://backend-main/api/v1/auth/register;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location = /api/v1/auth/login {
            limit_except POST { deny all; }
            proxy_pass http://backend-main/api/v1/auth/login;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
		
		location = /api/v1/auth/two-factor {
            limit_except PATCH { deny all; }
            proxy_pass http://backend-main/api/v1/auth/two-factor;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
		
		location = /api/v1/auth/change-password {
            limit_except PATCH { deny all; }
            proxy_pass http://backend-main/api/v1/auth/change-password;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==================== USER MANAGEMENT ====================
        location ~ ^/api/v1/users/([^/]+)$ {
            limit_except DELETE { deny all; }
            proxy_pass http://backend-main/api/v1/users/$1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==================== HABITS MANAGEMENT ====================
        location ~ ^/api/v1/users/([^/]+)/habits$ {
            limit_except POST DELETE { deny all; }
            proxy_pass http://backend-main/api/v1/users/$1/habits;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/api/v1/users/([^/]+)/habits/([^/]+)$ {
            limit_except DELETE { deny all; }
            proxy_pass http://backend-main/api/v1/users/$1/habits/$2;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==================== SCHEDULE MANAGEMENT ====================
        location ~ ^/api/v1/users/([^/]+)/schedule/import$ {
            limit_except POST { deny all; }
            proxy_pass http://backend-main/api/v1/users/$1/schedule/import;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==================== NOTIFICATIONS MANAGEMENT ====================
        location ~ ^/api/v1/users/([^/]+)/notifications/change-settings$ {
            limit_except PATCH { deny all; }
            proxy_pass http://backend-main/api/v1/users/$1/notifications/change-settings;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ==================== INTERNAL ENDPOINTS (MICROSERVICE ONLY) ====================
        
        location = /api/v1/internal/check-log-in {
            if ($http_x_microservice_auth != "$SECRET") {
                return 403 "Forbidden: Microservice authentication required";
            }
            
            limit_except POST {
                deny all;
            }
            proxy_pass http://backend-readers/api/v1/internal/check-log-in;
            proxy_set_header Host $host;
			proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        location = /api/v1/internal/get-users-to-notify {
            if ($http_x_microservice_auth != "$SECRET") {
                return 403 "Forbidden: Microservice authentication required";
            }
            
            limit_except GET {
                deny all;
            }
            proxy_pass http://backend-readers/api/v1/internal/get-users-to-notify;
            proxy_set_header Host $host;
			proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }
		
        location ~ ^/api/v1/internal/ {
            return 403 "Forbidden: Internal endpoints are not accessible externally";
        }

        location / {
            return 404 "Not Found";
        }
    }
}