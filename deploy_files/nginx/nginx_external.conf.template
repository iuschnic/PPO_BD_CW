load_module modules/ngx_http_headers_more_filter_module.so;

worker_processes auto;
worker_cpu_affinity auto;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;

    server_tokens off;
	more_clear_headers Server;
	
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log warn;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    
    # ==================== GZIP КОМПРЕССИЯ ====================
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        application/atom+xml
        application/geo+json
        application/javascript
        application/x-javascript
        application/json
        application/ld+json
        application/manifest+json
        application/rdf+xml
        application/rss+xml
        application/xhtml+xml
        application/xml
        font/eot
        font/otf
        font/ttf
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;
    gzip_min_length 256;
    gzip_buffers 16 8k;
    
    # ==================== КЭШИРОВАНИЕ ====================
    # Кэш для статических файлов
    proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=static_cache:10m max_size=1g 
                    inactive=60m use_temp_path=off;
    
    # Кэш для проксируемых запросов (кроме API)
    proxy_cache_path /var/cache/nginx/proxy levels=1:2 keys_zone=proxy_cache:20m 
                    max_size=2g inactive=30m use_temp_path=off;
    
    proxy_cache_key "$scheme$request_method$host$request_uri";
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    
    # Глобальные заголовки кэширования
    add_header X-Cache-Status $upstream_cache_status;

    upstream service-1 {
        server $SERVICE1_HOST:$SERVICE1_PORT;
    }
    upstream service-2 {
        server $SERVICE2_HOST:$SERVICE2_PORT;
    }
    
    upstream pgadmin {
        server $PGADMIN_HOST:$PGADMIN_PORT;
    }
    
    upstream grafana {
        server $GRAFANA_HOST:$GRAFANA_PORT;
    }

    server {
        listen $HOST;
        server_name localhost;
        charset utf-8;
        client_max_body_size 10M;
        
        # Название приложения для заголовков
        set $app_name "TaskTracker";
        set $app_version "1.0.0";
        
        root /usr/share/nginx/static;

        # Глобальные заголовки для всех ответов
        add_header X-Powered-By $app_name always;
        add_header X-Application-Name $app_name always;
        add_header X-Application-Version $app_version always;

        location /health {
            access_log off;
            add_header Server $app_name;
            return 200 "healthy\n";
        }
        
        location = /status {
            stub_status;
            add_header Server $app_name;
        }
        
        location / {
            try_files /index.html =404;
            add_header Server $app_name;
            
            # Кэширование HTML
            expires 1h;
            add_header Pragma "cache";
        }
        
        location = /reserved {
            add_header Server $app_name;
            return 302 /;
        }

        location = /documentation {
            alias /usr/share/nginx/static/documentation.html;
            add_header Content-Type "text/html; charset=utf-8";
            add_header Server $app_name;
            
            # Кэширование документации
            expires 2h;
        }
        
        location = /management {
            alias /usr/share/nginx/static/management.html;
            add_header Content-Type "text/html; charset=utf-8";
            add_header Server $app_name;
            
            # Кэширование management
            expires 2h;
        }
        
        location = /legacy {
            alias /usr/share/nginx/static/legacy/TaskTrackerClient.zip;
            add_header Content-Type "application/zip";
            add_header Content-Disposition "attachment; filename=TaskTrackerClient.zip";
            add_header X-Content-Type-Options "nosniff";
            add_header Server $app_name;
            
            # Кэширование больших файлов
            expires 1d;
        }
        
        location /admin/ {
            auth_basic "Database Administration";
            auth_basic_user_file /etc/nginx/.htpasswd;
            
            proxy_pass http://pgadmin/;
            
            # Подменяем заголовки Server в ответах от pgAdmin
            proxy_hide_header Server;
            proxy_hide_header X-Powered-By;
            add_header Server $app_name;
            add_header X-Powered-By $app_name;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            
            proxy_set_header X-Script-Name /admin;
            
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $http_connection;
            
            rewrite ^/admin/(.*)$ /$1 break;
            
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            
            proxy_buffering off;
            
            # Отключаем кэширование для админки
            proxy_no_cache 1;
            proxy_cache_bypass 1;
            expires -1;
        }

        location /static/ {
            alias /usr/share/nginx/static/;
            add_header Server $app_name;
            
            # Включаем кэш для статических файлов
            proxy_cache static_cache;
            proxy_cache_valid 200 302 1y;
            proxy_cache_valid 404 1m;
            proxy_cache_min_uses 2;
            
            location ~* \.md$ {
                add_header Access-Control-Allow-Origin "*";
                add_header Server $app_name;
                
                expires 1h;
            }
            
            location ~* \.(svg|png|jpg|jpeg|gif|ico|webp|avif)$ {
                expires 1y;
                add_header Access-Control-Allow-Origin "*";
                add_header Server $app_name;
            }
            
            location ~* \.(css|js)$ {
                expires 1y;
                add_header Access-Control-Allow-Origin "*";
                add_header Server $app_name;
            }
            
            location ~* \.html$ {
                add_header Server $app_name;
                
                expires 1h;
                add_header Cache-Control "public, must-revalidate";
            }
            
            location ~* \.(woff|woff2|ttf|eot)$ {
                expires 1y;
                add_header Access-Control-Allow-Origin "*";
                add_header Server $app_name;
            }
            
            # Общие настройки для статики
            expires 1y;
            access_log off;
            add_header X-Static-Cache "HIT";
        }
        
        # ==================== MONITORING ROUTES ====================

        location /monitoring/ {
            add_header Server $app_name;
            return 302 http://localhost:3000;
        }

        location = /monitoring {
            add_header Server $app_name;
            return 302 http://localhost:3000;
        }

        # ==================== MIRROR ROUTES ====================

        location = /mirror/api/v1/ {
            add_header Server $app_name;
            return 302 /mirror/api/v1/swagger/index.html;
        }

        # Swagger UI для mirror - исправленная версия
        location /mirror/api/v1/swagger/ {
            proxy_pass http://service-2/api/v1/swagger/;
            
            # Подменяем заголовки от бэкенда
            proxy_hide_header Server;
            proxy_hide_header X-Powered-By;
            add_header Server $app_name;
            add_header X-Powered-By $app_name;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Подменяем пути только в текстовых content-type
            sub_filter_once off;
            sub_filter_types text/html application/json text/javascript application/javascript;
            
            # Подменяем основные пути API
            sub_filter '/api/v1/' '/mirror/api/v1/';
            sub_filter '"/swagger/' '"/mirror/api/v1/swagger/';
            sub_filter 'href="/api/v1/' 'href="/mirror/api/v1/';
            sub_filter 'src="/api/v1/' 'src="/mirror/api/v1/';
            sub_filter 'url: "/api/v1/' 'url: "/mirror/api/v1/';
            sub_filter '"/swagger/v1/swagger.json"' '"/mirror/api/v1/swagger/v1/swagger.json"';
            
            # Добавляем заголовки для корректной подмены
            proxy_set_header Accept-Encoding "";
            
            # Кэширование Swagger UI
            proxy_cache proxy_cache;
            proxy_cache_valid 200 302 1h;
            proxy_cache_valid 404 1m;
            expires 1h;
            add_header Cache-Control "public";
        }

        # Swagger JSON для mirror
        location = /mirror/api/v1/swagger/v1/swagger.json {
            proxy_pass http://service-2/api/v1/swagger/v1/swagger.json;
            
            # Подменяем заголовки от бэкенда
            proxy_hide_header Server;
            proxy_hide_header X-Powered-By;
            add_header Server $app_name;
            add_header X-Powered-By $app_name;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            
            # Для JSON тоже нужно делать подмену
            sub_filter_once off;
            sub_filter_types application/json;
            sub_filter '/api/v1/' '/mirror/api/v1/';
            proxy_set_header Accept-Encoding "";
            
            # Кэширование Swagger JSON
            proxy_cache proxy_cache;
            proxy_cache_valid 200 1h;
            proxy_cache_valid 404 1m;
            expires 1h;
            add_header Cache-Control "public";
        }

        # Основные API endpoints для mirror - БЕЗ КЭШИРОВАНИЯ
        location ^~ /mirror/api/v1/ {
            proxy_pass http://service-2/api/v1/;
            
            # Подменяем заголовки от бэкенда
            proxy_hide_header Server;
            proxy_hide_header X-Powered-By;
            add_header Server $app_name;
            add_header X-Powered-By $app_name;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            
            # Явно отключаем кэширование для API endpoints
            proxy_no_cache 1;
            proxy_cache_bypass 1;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            add_header Pragma "no-cache";
        }

        # ==================== MAIN ROUTES ====================

        # Основные API endpoints - БЕЗ КЭШИРОВАНИЯ
        location ^~ /api/v1/ {
            proxy_pass http://service-1/api/v1/;
            
            # Подменяем заголовки от бэкенда
            proxy_hide_header Server;
            proxy_hide_header X-Powered-By;
            add_header Server $app_name;
            add_header X-Powered-By $app_name;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            
            # Явно отключаем кэширование для API endpoints
            proxy_no_cache 1;
            proxy_cache_bypass 1;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
            add_header Pragma "no-cache";
        }

        location = /api/v1/ {
            add_header Server $app_name;
            return 302 /api/v1/swagger/index.html;
            
            # Кэширование редиректа
            expires 1h;
            add_header Cache-Control "public";
        }
    }
}