worker_processes auto;
worker_cpu_affinity auto;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log warn;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    gzip on;
	
    upstream service-1 {
        server $SERVICE1_HOST:$SERVICE1_PORT;
    }
	upstream service-2 {
        server $SERVICE2_HOST:$SERVICE2_PORT;
    }
	
	upstream pgadmin {
        server $PGADMIN_HOST:$PGADMIN_PORT;
    }

    server {
        listen $HOST;
        server_name localhost;
        charset utf-8;
        client_max_body_size 10M;
		
		root /usr/share/nginx/static;

        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
		
		location = /status {
			stub_status;
		}
		
        location / {
            try_files /index.html =404;
            add_header Content-Type "text/html; charset=utf-8";
        }
		
		location = /reserved {
			return 302 /;
		}

        location = /documentation {
            alias /usr/share/nginx/static/documentation.html;
            add_header Content-Type "text/html; charset=utf-8";
        }
		
		location = /management {
			alias /usr/share/nginx/static/management.html;
            add_header Content-Type "text/html; charset=utf-8";
		}
		
        location = /legacy {
            alias /usr/share/nginx/static/legacy/TaskTrackerClient.zip;
            add_header Content-Type "application/zip";
            add_header Content-Disposition "attachment; filename=TaskTrackerClient.zip";
            add_header X-Content-Type-Options "nosniff";
        }
		
		location /admin/ {
            auth_basic "Database Administration";
            auth_basic_user_file /etc/nginx/.htpasswd;
            
            proxy_pass http://pgadmin/;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            
            proxy_set_header X-Script-Name /admin;
            
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $http_connection;
            
            rewrite ^/admin/(.*)$ /$1 break;
            
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            
            proxy_buffering off;
        }

        location /static/ {
            alias /usr/share/nginx/static/;
            
            location ~* \.md$ {
                add_header Content-Type "text/markdown; charset=utf-8";
                add_header Access-Control-Allow-Origin "*";
            }
            
            location ~* \.(svg|png|jpg|jpeg|gif|ico)$ {
                expires 1y;
                add_header Cache-Control "public, immutable";
                add_header Access-Control-Allow-Origin "*";
            }
            
            location ~* \.html$ {
                add_header Content-Type "text/html; charset=utf-8";
            }
            
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }

        # ==================== MIRROR ROUTES ====================

        location = /mirror/api/v1/ {
            return 302 /mirror/api/v1/swagger/index.html;
        }

        # Swagger UI для mirror - исправленная версия
        location /mirror/api/v1/swagger/ {
            proxy_pass http://service-2/api/v1/swagger/;
            
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Подменяем пути только в текстовых content-type
            sub_filter_once off;
            sub_filter_types text/html application/json text/javascript application/javascript;
            
            # Подменяем основные пути API
            sub_filter '/api/v1/' '/mirror/api/v1/';
            sub_filter '"/swagger/' '"/mirror/api/v1/swagger/';
            sub_filter 'href="/api/v1/' 'href="/mirror/api/v1/';
            sub_filter 'src="/api/v1/' 'src="/mirror/api/v1/';
            sub_filter 'url: "/api/v1/' 'url: "/mirror/api/v1/';
            sub_filter '"/swagger/v1/swagger.json"' '"/mirror/api/v1/swagger/v1/swagger.json"';
            
            # Добавляем заголовки для корректной подмены
            proxy_set_header Accept-Encoding "";
        }

        # Swagger JSON для mirror
        location = /mirror/api/v1/swagger/v1/swagger.json {
            proxy_pass http://service-2/api/v1/swagger/v1/swagger.json;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            
            # Для JSON тоже нужно делать подмену
            sub_filter_once off;
            sub_filter_types application/json;
            sub_filter '/api/v1/' '/mirror/api/v1/';
            proxy_set_header Accept-Encoding "";
        }

        # Основные API endpoints для mirror
        location ^~ /mirror/api/v1/ {
            proxy_pass http://service-2/api/v1/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        # ==================== MAIN ROUTES ====================

        location ^~ /api/v1/ {
            proxy_pass http://service-1/api/v1/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        location = /api/v1/ {
            return 302 /api/v1/swagger/index.html;
        }
    }
}