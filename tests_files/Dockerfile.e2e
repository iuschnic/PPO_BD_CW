FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

WORKDIR /src

# Копируем исходный код
COPY ["BD.sln", "BD.sln"]
COPY ["Domain/", "Domain/"]
COPY ["Storage/", "Storage/"]
COPY ["ShedLoadAdapter/", "ShedLoadAdapter/"]
COPY ["CLI/", "CLI/"]
COPY ["Tests/", "Tests/"]
COPY ["MessageSenderDomain/", "MessageSenderDomain/"]
COPY ["MessageSenderStorage/", "MessageSenderStorage/"]
COPY ["MessageSenderService/", "MessageSenderService/"]
COPY ["MessageSenderTaskTrackerClient/", "MessageSenderTaskTrackerClient/"]
COPY ["MessageSenderTelegramAdapter/", "MessageSenderTelegramAdapter/"]
COPY ["TaskTrackerDtoModels/", "TaskTrackerDtoModels/"]
COPY ["PublicTaskTrackerClient/", "PublicTaskTrackerClient/"]
COPY ["TaskTrackerMessageSenderClient/", "TaskTrackerMessageSenderClient/"]
COPY ["WebAPI/", "WebAPI/"]

RUN dotnet restore "Tests/Tests.csproj"
RUN dotnet restore "CLI/CLI.csproj"

RUN dotnet build "Tests/Tests.csproj" -c Release --no-restore
RUN dotnet build "CLI/CLI.csproj" -c Release --no-restore

# Устанавливаем инструменты для работы с PostgreSQL
RUN apt-get update && apt-get install -y postgresql-client && rm -rf /var/lib/apt/lists/*

# Запуск e2e тестов
ENTRYPOINT ["sh", "-c", \
  "echo 'Running E2E tests...' && \
   dotnet test Tests/Tests.csproj -c Release --no-build --filter \"Category=E2E\" --logger \"html;LogFileName=/test-results/e2e-report.html\""]